<%= render "layouts/app_navigation" %>

<div class="flex items-center justify-center gap-2 mt-15 mb-15">
  <h2 class="font-headline font-extrabold text-3xl tracking-tight text-primary">
    これまでの足跡
  </h2>

  <span
    class="material-symbols-outlined text-3xl text-primary"
    style="font-variation-settings: 'opsz' 28, 'wght' 300;">
    footprint
  </span>
</div>

<main class="w-full max-w-3xl mx-auto px-4 sm:px-6 mt-10 md:mt-14 pb-40 md:pb-32">
  <div class="mb-8">
    <details class="group">
      <summary class="flex items-center justify-between
                      p-4 bg-white rounded-2xl shadow-sm
                      cursor-pointer list-none
                      [&::-webkit-details-marker]:hidden">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary">
            search
          </span>

          <div>
            <p class="font-bold text-primary">
              予定を検索・絞り込み
            </p>
            <p class="text-xs text-primary/60">
              タイトル・タグ・年で検索できます
            </p>
          </div>
        </div>

        <span class="material-symbols-outlined text-primary
                     transition-transform duration-200
                     group-open:rotate-180">
          expand_more
        </span>
      </summary>

      <div class="mt-4">
      <%= form_with url: past_watchlists_path,
                    method: :get,
                    local: true,
                    class: "space-y-3" do |f| %>

        <div class="relative">
          <span class="material-symbols-outlined
                       absolute left-5 top-1/2 -translate-y-1/2
                       text-primary/50">
            search
          </span>

          <%= f.text_field :title,
                value: params[:title],
                class: "w-full h-14 pl-14 pr-6
                        bg-white border-none rounded-full shadow-sm
                        focus:outline-none focus:ring-2 focus:ring-primary
                        text-gray-700 font-medium
                        placeholder:text-gray-300",
                placeholder: "予定タイトルを検索" %>
        </div>

       <div class="relative">
          <span class="material-symbols-outlined
                       absolute left-5 top-1/2 -translate-y-1/2
                       text-primary/50">
            tag
          </span>

          <%= f.text_field :tag,
                value: params[:tag],
                class: "w-full h-14 pl-14 pr-6
                        bg-white border-none rounded-full shadow-sm
                        focus:outline-none focus:ring-2 focus:ring-primary
                        text-gray-700 font-medium
                        placeholder:text-gray-300",
                placeholder: "タグで絞り込み" %>
        </div>

        <div class="relative">
          <span class="material-symbols-outlined
                      absolute left-5 top-1/2 -translate-y-1/2
                      text-primary/50 pointer-events-none">
            calendar_month
          </span>

          <%= f.select :year,
                options_for_select(
                  [["すべての年", ""]] + @available_years.map { |year| ["#{year}年", year] },
                  params[:year]
                ),
                {},
                class: "w-full h-14 pl-14 pr-6
                        appearance-none
                        bg-white border-none rounded-full shadow-sm
                        focus:outline-none focus:ring-2 focus:ring-primary
                        text-gray-700 font-medium
                        cursor-pointer" %>
          <span class="material-symbols-outlined
               absolute right-5 top-1/2 -translate-y-1/2
               text-primary/50 pointer-events-none">
            expand_more
          </span>
        </div>

        <div class="flex justify-end">
          <%= f.submit "検索",
                class: "h-12 px-6
                        rounded-full
                        bg-[#B6E0F3] text-[#2d6489]
                        font-bold shadow-sm
                        hover:brightness-105
                        active:scale-95
                        transition-all" %>
        </div>
      <% end %>
      </div>
  </details>

    <% if params[:title].present? || params[:tag].present? || params[:year].present? %>
      <div class="mt-4 mb-6 flex flex-wrap items-center gap-2 px-2">
        <span class="text-xs font-bold text-primary/50">
          検索条件
        </span>

        <% if params[:title].present? %>
          <span class="inline-flex items-center gap-1
                       text-sm font-medium text-primary/80
                       bg-primary/5
                       px-2.5 py-1
                       rounded-lg">
            <span class="material-symbols-outlined text-base">
              search
            </span>
            <%= params[:title] %>
          </span>
        <% end %>

        <% if params[:tag].present? %>
          <span class="inline-flex items-center gap-1
                       text-sm font-medium text-primary/80
                       bg-primary/5
                       px-2.5 py-1
                       rounded-lg">
            <span class="material-symbols-outlined text-base">
              tag
            </span>
            <%= params[:tag] %>
          </span>
        <% end %>

        <% if params[:year].present? %>
          <span class="inline-flex items-center gap-1
                       text-sm font-medium text-primary/80
                      bg-primary/5
                      px-2.5 py-1
                      rounded-lg">
            <span class="material-symbols-outlined text-base">
              calendar_month
            </span>
            <%= params[:year] %>年
          </span>
        <% end %>

        <%= link_to past_watchlists_path,
            class: "inline-flex items-center gap-1
                    text-xs font-bold text-primary
                    bg-[#B6E0F3]/40 px-3 py-1.5
                    rounded-full hover:bg-[#B6E0F3]/70
                    active:scale-95 transition-all" do %>
          <span class="material-symbols-outlined text-sm">
            close
          </span>
          解除
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end mb-4">
    <%= form_with url: past_watchlists_path, method: :get, local: true,
                  class: "flex items-center gap-2" do |f| %>
      <%= f.hidden_field :title, value: params[:title] %>
      <%= f.hidden_field :tag, value: params[:tag] %>
      <%= f.hidden_field :year, value: params[:year] %>

      <%= f.label :sort, "並び順",
            class: "text-sm font-medium text-gray-600" %>

      <div class="relative">
        <span class="material-symbols-outlined
                     absolute left-3 top-1/2 -translate-y-1/2
                     text-[#2d6489] pointer-events-none text-lg">
          swap_vert
        </span>

        <%= f.select :sort,
              options_for_select(
                [["新しい順", "desc"], ["古い順", "asc"]],
                params[:sort] || "desc"
              ),
              {},
              class: "appearance-none
                      h-10 pl-10 pr-9
                      rounded-full
                      bg-white border border-[#B6E0F3] text-[#2d6489]
                      text-sm font-bold shadow-sm
                      cursor-pointer
                      focus:outline-none focus:ring-2 focus:ring-primary
                      hover:brightness-105 transition-all",
              onchange: "this.form.requestSubmit()" %>

        <span class="material-symbols-outlined
                     absolute right-3 top-1/2 -translate-y-1/2
                     text-[#2d6489] pointer-events-none text-lg">
          expand_more
        </span>
      </div>
    <% end %>
  </div>

  <% if (params[:tag].present? || params[:title].present? || params[:year].present?) &&
      @past_watchlists.empty? %>

    <div class="flex flex-col items-center justify-center
                px-5 py-10 md:py-12
                text-center bg-white/30 rounded-3xl
                border border-dashed border-[#4f5052]">

      <span class="material-symbols-outlined text-4xl text-[#B6E0F3] mb-2">
        search_off
      </span>

      <p class="text-[#4f5052] text-sm sm:text-base font-headline font-bold leading-relaxed">
        条件に一致する予定はありません
      </p>
    </div>

  <% elsif @past_watchlists.any? %>
    <div class="space-y-6 md:space-y-8">
      <% @grouped_watchlists.each do |(year, month), watchlists| %>
        <section>
          <h2 class="flex items-center gap-2 mb-4
                     text-[#2d6489] font-bold">
            <span class="material-symbols-outlined">
              calendar_month
            </span>
            <%= "#{year}年 #{month}月" %>
          </h2>

          <div class="space-y-4 md:space-y-5">
            <% watchlists.each do |watchlist| %>
              <%= render "watchlist_card", watchlist: watchlist, is_past: true %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center justify-center
                px-5 py-10 md:py-12
                text-center bg-white/30 rounded-3xl
                border border-dashed border-[#4f5052]">

      <span class="material-symbols-outlined text-4xl text-[#B6E0F3] mb-2">
        footprint
      </span>

      <p class="text-[#4f5052] text-sm sm:text-base font-headline font-bold leading-relaxed">
        これまでの足跡はまだありません
      </p>
    </div>
  <% end %>
</main>

<%= render "layouts/footer" %>
