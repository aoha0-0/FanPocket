<p>FanPocketにお問い合わせが届きました。</p>

<hr>

<p>
  <strong>問い合わせ種別</strong><br>
  <%= @category_label %>
</p>

<p>
  <strong>問い合わせ内容</strong>
</p>

<div>
  <%= simple_format(@contact.content) %>
</div>

<hr>

<% if @user.present? %>
  <p><strong>送信ユーザーID</strong><br><%= @user.id %></p>
<% else %>
  <p><strong>送信ユーザー</strong><br>未ログイン</p>
<% end %>

<p>
  <strong>メールアドレス</strong><br>
  <%= @user&.email.presence || @contact.email %>
</p>
