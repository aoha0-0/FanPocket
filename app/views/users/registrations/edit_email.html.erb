<%= render "layouts/app_navigation" %>

<main class="w-full max-w-xl mx-auto px-4 sm:px-6 mt-10 md:mt-14 pb-28 md:pb-12">
  <div class="mb-8 text-center">
    <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-[#f0f8fc] flex items-center justify-center">
      <span class="material-symbols-outlined text-[#2d6489] text-4xl">
        alternate_email
      </span>
    </div>

    <h2 class="font-headline font-extrabold text-2xl md:text-3xl tracking-tight text-primary">
      メールアドレスの変更
    </h2>

    <p class="mt-3 text-sm font-medium text-gray-500 leading-relaxed px-4">
      現在のパスワードを確認して、<br class="sm:hidden">
      新しいメールアドレスへ変更します
    </p>

    <p class="mt-1 text-xs text-gray-400">
      メールアドレスとパスワードで登録した方のみ変更できます
    </p>
  </div>

  <%= form_for(resource,
               as: resource_name,
               url: update_user_email_path,
               html: { method: :patch }) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-5">
      <div>
        <p class="text-gray-500 text-[11px] font-bold px-4 tracking-widest">
          現在のメールアドレス
        </p>

        <div class="mt-2 w-full h-14 px-5 flex items-center bg-gray-50 rounded-2xl text-gray-400 shadow-sm">
          <%= current_user.email %>
        </div>
      </div>

      <div>
        <%= f.label :email,
                    "新しいメールアドレス",
                    class: "text-gray-500 text-[11px] font-bold px-4 tracking-widest" %>

        <div class="relative group mt-2">
          <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-[#8BBEE8] group-focus-within:text-primary transition-colors">
            <span class="material-symbols-outlined text-[20px]">mail</span>
          </div>

          <%= f.email_field :email,
                            value: nil,
                            autocomplete: "email",
                            placeholder: "example@mail.com",
                            class: "w-full h-14 pl-13 pr-5 bg-[#f0f4f8] border-none rounded-2xl shadow-inner focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all text-gray-700 font-medium placeholder:text-gray-300" %>
        </div>
      </div>

      <div>
        <%= f.label :current_password,
                    "現在のパスワード",
                    class: "text-gray-500 text-[11px] font-bold px-4 tracking-widest" %>

        <div class="relative group mt-2" data-controller="password-toggle">
          <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-[#8BBEE8] group-focus-within:text-primary transition-colors">
            <span class="material-symbols-outlined text-[20px]">lock</span>
          </div>

          <%= f.password_field :current_password,
                               autocomplete: "current-password",
                               placeholder: "••••••••",
                               class: "w-full h-14 pl-13 pr-14 bg-[#f0f4f8] border-none rounded-2xl shadow-inner focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all text-gray-700 font-medium placeholder:text-gray-300",
                               data: { password_toggle_target: "input" } %>

          <button type="button"
                  class="absolute inset-y-0 right-0 pr-5 flex items-center text-gray-400 hover:text-primary transition-colors"
                  data-action="password-toggle#toggle">
            <span class="material-symbols-outlined text-[20px]"
                  data-password-toggle-target="icon">
              visibility
            </span>
          </button>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= f.button type: "submit",
                   class: "w-full bg-[#B6E0F3] text-[#2d6489] font-headline font-bold py-4 rounded-full puffy-shadow hover:brightness-105 transition-all active:scale-[0.97] cursor-pointer flex items-center justify-center gap-2" do %>
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        メールアドレスを変更する
      <% end %>
    </div>

    <div class="mt-5 text-center">
      <%= link_to "キャンセル",
                  settings_path,
                  class: "text-sm font-medium text-gray-500 hover:text-primary transition-colors" %>
    </div>
  <% end %>
</main>

<%= render "layouts/footer" %>
